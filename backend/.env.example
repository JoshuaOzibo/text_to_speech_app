# LocalAudioBook backend configuration.
# Narration runs entirely on this machine. Every API key below is optional.
# Copy this file to .env to override any default.

# Port the API server listens on. The frontend dev server proxies /api here.
PORT=3001

# "production" makes the backend also serve ../frontend/dist from the same port.
NODE_ENV=development

# How much the server prints: silent, error, warn, info (default), or debug.
# Use debug to trace a stall - it adds per-synthesis timings and cache hits.
LOG_LEVEL=info

# Largest book file accepted by the uploader, in megabytes.
MAX_UPLOAD_MB=50

# Words of text sent to Piper per chunk. Lower = smoother progress reporting.
WORDS_PER_CHUNK=300

# Words per chunk for read-aloud, where the player narrates one chunk while the
# next is still being synthesized. Much smaller than WORDS_PER_CHUNK because
# this one sets how long you wait before the first word is spoken.
READ_WORDS_PER_CHUNK=60

# The opening chunk is cut smaller still, because its synthesis time is the
# whole wait between pressing play and hearing the first word.
READ_LEAD_WORDS=25

# Narrated chunks kept on disk per book, so seeking backwards is instant.
# Roughly a megabyte each.
READ_CACHE_CHUNKS=40

# Chunks narrated at once. The player plays one while asking for the next two,
# so three is its natural pipeline depth - lower than that and the chunk it is
# waiting on queues behind speculative work and playback stalls.
READ_CONCURRENCY=3

# --- Background music -------------------------------------------------------
# Both keys are optional. Without them the feature still works: the mood is
# worked out locally from the book text, and tracks come from Openverse, which
# needs no key and is filtered to CC0 (commercial use, no attribution).

# Lets Gemini pick the mood instead of the local keyword pass, and write the
# narrator introduction and closing for "Clean with AI". Both send an excerpt of
# the open book to Google - a few thousand characters - and only when you press
# the button. It is also one of the providers "Summarize" can use (see below),
# and that one sends the WHOLE book. Narration always stays fully offline.
#
# Mood and Clean with AI work without this key: the mood falls back to local
# keyword scoring, and the intro falls back to a standard template. Clean with AI
# still strips the title page and the index either way, because that part is local.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Music libraries are tried in order: Freesound, ccMixter, Openverse, Pixabay.
# The first that answers wins, so a dead or rate-limited one is skipped rather
# than failing the whole search. The middle two need no key at all.

# Free token from https://freesound.org/apiv2/apply/ - set this. Freesound is
# field recordings, real instrument drones and room tone, searched by phrase and
# filtered to CC0, so nothing you publish needs a credit. ccMixter, the keyless
# fallback, is a remix community whose tags are inconsistent.
FREESOUND_API_KEY=

# NOTE: Pixabay's public API covers images and videos only. Its audio endpoint
# answers 403 "Access denied" even with a valid key, so it sits last in the
# chain in case they ever open it up - it is not a working source today.
PIXABAY_API_KEY=

# How long a track may take to download before giving up. Freesound serves its
# high-quality previews at roughly 75 KB/s to this machine, so a 5-minute drone
# (~7MB) needs about 90 seconds. Auditioning in the picker uses the smaller
# low-quality preview (~2.5MB); only the track you actually pick is fetched at
# full quality.
BACKGROUND_DOWNLOAD_TIMEOUT_MS=300000

# Every candidate is decoded for 20 seconds and measured before you see it.
# Anything whose loudness wanders more than BACKGROUND_MAX_FLATNESS_DB, or whose
# quiet-to-loud span exceeds BACKGROUND_MAX_RANGE_DB, is dropped as having beats
# or dynamics. Measured reference points: rain, room tone and drones sit at
# 0.9-4.1 dB; a drum-led track measured 10.2 dB.
BACKGROUND_MAX_FLATNESS_DB=6
BACKGROUND_MAX_RANGE_DB=16

# Beds shorter than this loop too obviously; longer ones are usually whole
# compositions rather than a steady bed. Seconds.
BACKGROUND_MIN_SECONDS=90
BACKGROUND_MAX_SECONDS=900

# Music is downloaded as its own file and never mixed into the audiobook, so
# there is no level, duck or fade to set. BACKGROUND_LEVEL_DB, BACKGROUND_DUCK_DB
# and BACKGROUND_FADE_SEC were removed on 2026-09-11 and are now ignored.

# How long to wait on Gemini or the music library before giving up.
SUGGEST_TIMEOUT_MS=20000

# CLEANUP_DELAY_MINUTES was removed on 2026-09-12. Downloading no longer deletes
# the MP3 - it is kept until the next generation replaces it, so the download
# button stays usable. Setting it now does nothing; it is safe to delete.

# Bitrate for the exported MP3. Piper's 16-22.05kHz output clamps to 160k
# (an MPEG-2 Layer III limit); Supertonic's 44.1kHz output uses the full value.
MP3_BITRATE=192k

# Supertonic denoising steps, 1-10. Higher is better quality and proportionally
# slower: 2 ~= 0.23x realtime, 4 ~= 0.42x, 8 ~= 0.64x on an idle 4-core machine.
SUPERTONIC_STEPS=4

# Kokoro model build. fp32 is both the best quality and the fastest here: int8
# kernels are slower than float on CPUs without VNNI (fp32 1.63x realtime vs q8
# 3.69x). Only choose q8 if the 310MB fp32 download is a problem.
# Must match what you downloaded: npm run get:kokoro [fp32|fp16|q8|q4|q4f16]
KOKORO_DTYPE=fp32

# Largest slice of text sent to Kokoro in one call, in CHARACTERS. Kokoro
# tokenises phonemes one character per token and truncates at 512 without
# raising an error, so text past the cap is silently never spoken - at
# WORDS_PER_CHUNK=300 that was ~73% of every chunk. Chunks over this are split
# at sentence (then clause) boundaries and concatenated, so this changes nothing
# upstream: the chunk count, resume and the word timeline are unaffected.
# Measured here: real prose runs 1.03 phoneme characters per text character
# (worst case 1.12), so 400 leaves ~24% headroom. Re-measure before raising it.
KOKORO_MAX_CHARS=400

# Silence inserted where two internal pieces of one Kokoro chunk are joined.
# Each piece is trimmed back to its own speech first, because Kokoro pads every
# utterance with ~303ms of lead and ~497ms of tail and joining them raw left a
# ~990ms hole mid-paragraph. The joins fall at sentence ends, so 400 (~460ms
# once the trimmed edges are added back) matches the 380-690ms band Kokoro's own
# sentence pauses measure here, and is long enough for findPauses to anchor on.
KOKORO_JOIN_SILENCE_MS=400

# --- Summaries ----------------------------------------------------------------
# "Summarize" writes a timed summary of the open book (default 30 minutes) with
# one of four providers, chosen on the Summarize page. Every key is optional;
# a provider without one is shown greyed out with the reason.
#
# PRIVACY: Gemini, Claude and DeepSeek receive the FULL TEXT of the book, and
# only when you press Summarize. Ollama runs on this PC and sends nothing.
#
# Words the summary may use per minute of requested length. Measured voices
# speak 180-187 words a minute, so 165 makes "30 minutes" come in under 30.
SUMMARY_WORDS_PER_MINUTE=165
# Requests to a cloud provider at once. Ollama always runs one at a time.
SUMMARY_CONCURRENCY=2
# How long one cloud request may take before it is retried.
SUMMARY_TIMEOUT_MS=180000
# Gemini model for summaries only; empty means GEMINI_MODEL. The free tier of
# gemini-3.6-flash allows 20 requests a day - roughly two long summaries.
SUMMARY_GEMINI_MODEL=

# Claude (paid). Key: https://platform.claude.com/settings/keys
# CLAUDE_API_KEY is accepted too.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# DeepSeek (paid, needs a top-up). Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Free summary providers (limits checked 2026-09-28) ---
# Groq. Free key, no card: https://console.groq.com/keys
# 1,000 requests and 200,000
# tokens a day - about a 100,000-word book; a longer one carries on next day.
# The free tier allows 8,000 tokens a minute, which sets how big each passage
# can be. Raise GROQ_TOKENS_PER_MINUTE only on a paid Groq tier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TOKENS_PER_MINUTE=8000

# Mistral. Free "Experiment" plan, phone number, no card: https://console.mistral.ai/api-keys
# Limits are shown on the console's Limits page. The free plan may train on
# what you send unless you switch that off in the console's privacy settings.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# OpenRouter. Free key, no card: https://openrouter.ai/settings/keys
# Free models need their hosts allowed at https://openrouter.ai/settings/privacy
# Models ending ":free" cost
# nothing: 50 requests a day across all of them (1,000 once you have ever bought
# $10 of credit). Leave OPENROUTER_MODEL empty to use a free model OpenRouter
# still lists, or set one, e.g. qwen/qwen3.8-27b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (https://ollama.com/download/windows) runs a model on this PC: free, no
# key, no daily limit, and nothing leaves the machine - but on a 4-core CPU a
# long book takes hours. Install it, then: ollama pull qwen2.5:7b
# Empty OLLAMA_MODEL uses the first model you have pulled; the page lets you pick.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Context window in tokens. Bigger fits more of a chapter per request but needs
# more RAM; chapters longer than it allows are split into parts automatically.
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_MS=1800000

# --- Text preparation --------------------------------------------------------
# Optional: create backend/lexicon.txt (one word per line, # for comments) to
# teach the letter-spacing repair names it cannot know from the book itself,
# e.g. Kautilya or Arthashastra. Not a setting - just a file it reads if present.
#
# Prepend a throwaway ". " to each chunk so the engine warms up on it instead of
# on the first real word. The lead silence it creates is trimmed back off.
# Set false if a voice renders the token audibly.
TTS_WARMUP=true

# --- Per-chunk conditioning --------------------------------------------------
# Every chunk is levelled to this RMS so merged chunks don't jump in volume.
CHUNK_TARGET_DBFS=-20
# Gain is capped so the loudest sample never exceeds this - prevents clipping.
CHUNK_PEAK_CEILING_DBFS=-1
# Fades at each chunk edge. This is what removes the clicks at joins.
CHUNK_FADE_MS=50
# Silence after each chunk, and after the last chunk of a chapter. Chunks break
# between sentences, where the voice already leaves a pause of its own, so a long
# gap here reads as a stall in the middle of a paragraph.
CHUNK_GAP_MS=80
CHAPTER_GAP_MS=2000
# Anything below this counts as silence when trimming chunk edges.
SILENCE_FLOOR_DBFS=-50
LEAD_IN_MS=30

# --- Final mastering ---------------------------------------------------------
# Applied in one ffmpeg pass: highpass -> compressor -> loudnorm -> MP3.
HIGHPASS_HZ=80
COMPRESSOR_ENABLED=true
LOUDNORM_I=-16
LOUDNORM_TP=-1.5
LOUDNORM_LRA=11
