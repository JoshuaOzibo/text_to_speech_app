# LocalAudioBook backend configuration.
# Everything runs locally - there are no API keys, accounts, or billing.
# Copy this file to .env to override any default.

# Port the API server listens on. The frontend dev server proxies /api here.
PORT=3001

# "production" makes the backend also serve ../frontend/dist from the same port.
NODE_ENV=development

# How much the server prints: silent, error, warn, info (default), or debug.
# Use debug to trace a stall - it adds per-synthesis timings and cache hits.
LOG_LEVEL=info

# Largest book file accepted by the uploader, in megabytes.
MAX_UPLOAD_MB=50

# Words of text sent to Piper per chunk. Lower = smoother progress reporting.
WORDS_PER_CHUNK=300

# Words per chunk for read-aloud, where the player narrates one chunk while the
# next is still being synthesized. Much smaller than WORDS_PER_CHUNK because
# this one sets how long you wait before the first word is spoken.
READ_WORDS_PER_CHUNK=60

# The opening chunk is cut smaller still, because its synthesis time is the
# whole wait between pressing play and hearing the first word.
READ_LEAD_WORDS=25

# Narrated chunks kept on disk per book, so seeking backwards is instant.
# Roughly a megabyte each.
READ_CACHE_CHUNKS=40

# Chunks narrated at once. The player plays one while asking for the next two,
# so three is its natural pipeline depth - lower than that and the chunk it is
# waiting on queues behind speculative work and playback stalls.
READ_CONCURRENCY=3

# --- Background music -------------------------------------------------------
# Both keys are optional. Without them the feature still works: the mood is
# worked out locally from the book text, and tracks come from Openverse, which
# needs no key and is filtered to CC0 (commercial use, no attribution).

# Lets Gemini pick the mood instead of the local keyword pass. Setting this
# sends an excerpt of the open book to Google when you press Suggest - nothing
# else ever leaves the machine, and narration stays fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Music libraries are tried in order: Freesound, ccMixter, Openverse, Pixabay.
# The first that answers wins, so a dead or rate-limited one is skipped rather
# than failing the whole search. The middle two need no key at all.

# Free token from https://freesound.org/apiv2/apply/ - set this. Freesound is
# field recordings, real instrument drones and room tone, searched by phrase and
# filtered to CC0, so nothing you publish needs a credit. ccMixter, the keyless
# fallback, is a remix community whose tags are inconsistent.
FREESOUND_API_KEY=

# NOTE: Pixabay's public API covers images and videos only. Its audio endpoint
# answers 403 "Access denied" even with a valid key, so it sits last in the
# chain in case they ever open it up - it is not a working source today.
PIXABAY_API_KEY=

# How long a track may take to download before giving up. Freesound serves its
# high-quality previews at roughly 75 KB/s to this machine, so a 5-minute drone
# (~7MB) needs about 90 seconds. Auditioning in the picker uses the smaller
# low-quality preview (~2.5MB); only the track you actually pick is fetched at
# full quality.
BACKGROUND_DOWNLOAD_TIMEOUT_MS=300000

# Every candidate is decoded for 20 seconds and measured before you see it.
# Anything whose loudness wanders more than BACKGROUND_MAX_FLATNESS_DB, or whose
# quiet-to-loud span exceeds BACKGROUND_MAX_RANGE_DB, is dropped as having beats
# or dynamics. Measured reference points: rain, room tone and drones sit at
# 0.9-4.1 dB; a drum-led track measured 10.2 dB.
BACKGROUND_MAX_FLATNESS_DB=6
BACKGROUND_MAX_RANGE_DB=16

# Beds shorter than this loop too obviously; longer ones are usually whole
# compositions rather than a steady bed. Seconds.
BACKGROUND_MIN_SECONDS=90
BACKGROUND_MAX_SECONDS=900

# How far below the narration the music sits, before ducking. Quieter is safer:
# -20 dB is background, -12 dB starts competing with the voice.
BACKGROUND_LEVEL_DB=-20

# Seconds of fade at the start and end of the book.
BACKGROUND_FADE_SEC=3

# How long to wait on Gemini or the music library before giving up.
SUGGEST_TIMEOUT_MS=20000

# How long the generated MP3 survives after a download, in minutes.
CLEANUP_DELAY_MINUTES=5

# Bitrate for the exported MP3. Piper's 16-22.05kHz output clamps to 160k
# (an MPEG-2 Layer III limit); Supertonic's 44.1kHz output uses the full value.
MP3_BITRATE=192k

# Supertonic denoising steps, 1-10. Higher is better quality and proportionally
# slower: 2 ~= 0.23x realtime, 4 ~= 0.42x, 8 ~= 0.64x on an idle 4-core machine.
SUPERTONIC_STEPS=4

# Kokoro model build. fp32 is both the best quality and the fastest here: int8
# kernels are slower than float on CPUs without VNNI (fp32 1.63x realtime vs q8
# 3.69x). Only choose q8 if the 310MB fp32 download is a problem.
# Must match what you downloaded: npm run get:kokoro [fp32|fp16|q8|q4|q4f16]
KOKORO_DTYPE=fp32

# --- Text preparation --------------------------------------------------------
# Optional: create backend/lexicon.txt (one word per line, # for comments) to
# teach the letter-spacing repair names it cannot know from the book itself,
# e.g. Kautilya or Arthashastra. Not a setting - just a file it reads if present.
#
# Prepend a throwaway ". " to each chunk so the engine warms up on it instead of
# on the first real word. The lead silence it creates is trimmed back off.
# Set false if a voice renders the token audibly.
TTS_WARMUP=true

# --- Per-chunk conditioning --------------------------------------------------
# Every chunk is levelled to this RMS so merged chunks don't jump in volume.
CHUNK_TARGET_DBFS=-20
# Gain is capped so the loudest sample never exceeds this - prevents clipping.
CHUNK_PEAK_CEILING_DBFS=-1
# Fades at each chunk edge. This is what removes the clicks at joins.
CHUNK_FADE_MS=50
# Silence after each chunk, and after the last chunk of a chapter. Chunks break
# between sentences, where the voice already leaves a pause of its own, so a long
# gap here reads as a stall in the middle of a paragraph.
CHUNK_GAP_MS=80
CHAPTER_GAP_MS=2000
# Anything below this counts as silence when trimming chunk edges.
SILENCE_FLOOR_DBFS=-50
LEAD_IN_MS=30

# --- Final mastering ---------------------------------------------------------
# Applied in one ffmpeg pass: highpass -> compressor -> loudnorm -> MP3.
HIGHPASS_HZ=80
COMPRESSOR_ENABLED=true
LOUDNORM_I=-16
LOUDNORM_TP=-1.5
LOUDNORM_LRA=11
